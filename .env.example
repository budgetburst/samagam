# ==========================================
# KVS Samagam Automation - Render.com Environment
# ==========================================

# Target Portal URL (Default: https://samagam.kvs.gov.in)
KVS_BASE_URL=https://samagam.kvs.gov.in

# Authentication Credentials
# Comma-separated list of login IDs to manage simultaneously
KVS_LOGIN_IDS=YOUR_LOGIN_ID_1,YOUR_LOGIN_ID_2,YOUR_LOGIN_ID_3
KVS_LOGIN_ID=YOUR_LOGIN_ID_1
# Universal password baseline
KVS_UNIVERSAL_PASSWORD=YOUR_UNIVERSAL_PASSWORD
# Optional alternate password (used if portal was temporarily changed to regain access and restore)
KVS_ALTERNATE_PASSWORD=YOUR_ALTERNATE_PASSWORD

# Timer Intervals (in milliseconds)
# 5 minutes = 300000 ms (Verification in separate profile)
CHECK_INTERVAL_MS=300000
# 15 minutes = 900000 ms (Relogin in main logged-in profile)
RELOGIN_INTERVAL_MS=900000

# Browser & Display Settings
# Cloudflare Turnstile blocks standard headless mode.
# Inside Render Docker, Xvfb provides a virtual screen, so HEADLESS=false works perfectly!
HEADLESS=false
BROWSER_CHANNEL=chromium

# Profile Storage Directory
# Root directory where separate profiles are stored:
#   - .kvs_render_profile/main_profile (Keeps session logged in & handles 15m relogin)
#   - .kvs_render_profile/verify_profile (Isolated profile for 5m verification)
DATA_DIR=./.kvs_render_profile

# Web Service Port (Used for Render Web Service health checks)
PORT=10000

# Timeouts & Retries (in milliseconds)
NAVIGATION_TIMEOUT_MS=30000
ACTION_TIMEOUT_MS=15000
TURNSTILE_TIMEOUT_MS=25000
MAX_RETRIES=3
